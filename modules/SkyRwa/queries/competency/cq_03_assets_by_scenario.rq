# CQ3: Which route-optimization data products derive from which flight evidence?

PREFIX skyrwa: <https://w3id.org/skyrwa#>

SELECT ?product ?candidate ?evidence
WHERE {
    ?product a skyrwa:GovernedDataProduct ;
             skyrwa:hasAssetClass "route_optimization_sample" ;
             skyrwa:aggregatesCandidate ?candidate .
    ?candidate skyrwa:derivedFromEvidence ?evidence .
}
ORDER BY ?product ?candidate
