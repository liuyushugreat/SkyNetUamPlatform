# CQ6: Which data products are aggregated from multiple flight candidates
# with complete lineage?

PREFIX skyrwa: <https://w3id.org/skyrwa#>

SELECT ?product ?assetClass (COUNT(?candidate) AS ?sourceCount)
WHERE {
    ?product a skyrwa:GovernedDataProduct ;
             skyrwa:hasAssetClass ?assetClass ;
             skyrwa:aggregatesCandidate ?candidate .
    ?candidate skyrwa:derivedFromEvidence ?evidence .
}
GROUP BY ?product ?assetClass
HAVING (COUNT(?candidate) > 1)
ORDER BY DESC(?sourceCount)
