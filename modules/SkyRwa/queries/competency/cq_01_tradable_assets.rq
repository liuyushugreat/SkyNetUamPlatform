# CQ1: Which flight evidence records can be promoted to tradable asset candidates?
# A flight evidence is promotable if it has a digest, a non-empty flightId,
# and an associated asset candidate whose rights profile marks it tradable.

PREFIX skyrwa: <https://w3id.org/skyrwa#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?asset ?flightId ?assetClass
WHERE {
    ?asset a skyrwa:AssetCandidate ;
           skyrwa:flightId ?flightId ;
           skyrwa:hasAssetClass ?assetClass ;
           skyrwa:hasRightsProfile ?rp .
    ?rp skyrwa:isTradable "true"^^xsd:boolean .
}
ORDER BY ?flightId
