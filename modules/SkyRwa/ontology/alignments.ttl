@prefix skyrwa:  <urn:skyrwa:ontology#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix schema:  <http://schema.org/> .

# ============================================================================
# Alignments — mapping SkyRwa classes / properties to standard vocabularies
# ============================================================================
# This file documents how SkyRwa domain concepts align with:
#   - PROV-O    (W3C Provenance Ontology)
#   - DCAT      (Data Catalog Vocabulary)
#   - ODRL 2.2  (Open Digital Rights Language)
#   - SSN/SOSA  (Sensor, Observation, Sample, and Actuator ontology)
#   - Schema.org / Dublin Core Terms
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# PROV-O Alignments — provenance tracking
# ────────────────────────────────────────────────────────────────────────────

skyrwa:FlightEvidence rdfs:subClassOf prov:Entity .
skyrwa:AssetCandidate rdfs:subClassOf prov:Entity .
skyrwa:GovernedDataProduct rdfs:subClassOf prov:Entity .
skyrwa:RevenueRight rdfs:subClassOf prov:Entity .
skyrwa:SettlementRecord rdfs:subClassOf prov:Entity .

skyrwa:GovernanceDecision rdfs:subClassOf prov:Activity .
skyrwa:FlightMission rdfs:subClassOf prov:Activity .
skyrwa:UsageEvent rdfs:subClassOf prov:Activity .

skyrwa:UAV rdfs:subClassOf prov:Agent .
skyrwa:Operator rdfs:subClassOf prov:Agent .
skyrwa:DataConsumer rdfs:subClassOf prov:Agent .

skyrwa:derivedFromEvidence rdfs:subPropertyOf prov:wasDerivedFrom .
skyrwa:hasLineage rdfs:subPropertyOf prov:wasDerivedFrom .
skyrwa:operatedBy rdfs:subPropertyOf prov:wasAttributedTo .
skyrwa:appliedToAsset rdfs:subPropertyOf prov:used .

# PROV usage: a GovernanceDecision prov:used a FlightEvidence
# PROV generation: a GovernanceDecision prov:generated an AssetCandidate

# ────────────────────────────────────────────────────────────────────────────
# DCAT Alignments — governed products as datasets
# ────────────────────────────────────────────────────────────────────────────

skyrwa:GovernedDataProduct rdfs:subClassOf dcat:Dataset .

skyrwa:hasAssetClass rdfs:subPropertyOf dcat:theme .
# DCAT 3 temporal extent uses dcat:startDate / dcat:endDate (xsd:date or dcterms:PeriodOfTime).
# The SkyRwa datatypes are xsd:dateTime so we align at the informal level only.

# Informal temporal alignment to DCAT 3 (dateTime precision retained on SkyRwa side)
# skyrwa:startTime ~ dcat:startDate ; skyrwa:endTime ~ dcat:endDate .

# ────────────────────────────────────────────────────────────────────────────
# ODRL Alignments — usage policies and rights (formal axioms)
# ────────────────────────────────────────────────────────────────────────────

# RightsProfile maps to an ODRL Policy:
#   - permitted_uses   -> odrl:permission
#   - prohibited_uses  -> odrl:prohibition
#   - tradable         -> odrl:permission with odrl:action = odrl:distribute
#   - desensitization  -> odrl:duty (obligation before use)

skyrwa:RightsProfile a owl:Class ;
    rdfs:subClassOf odrl:Policy ;
    rdfs:label "rights profile"@en ;
    rdfs:comment "Governance-assigned usage-rights profile of an asset; formally an ODRL policy whose permitted_uses map to odrl:permission components and prohibited_uses to odrl:prohibition components."@en .

skyrwa:hasRightsProfile rdfs:subPropertyOf odrl:hasPolicy ;
    rdfs:range skyrwa:RightsProfile ;
    rdfs:comment """Attaches the governance-assigned odrl:Policy to the asset.
Each permitted_use maps to an odrl:Permission, each prohibited_use to an
odrl:Prohibition; tradability corresponds to an odrl:Permission with
odrl:action odrl:distribute, and desensitization to an odrl:Duty."""@en .

# ────────────────────────────────────────────────────────────────────────────
# SSN/SOSA Alignments — sensor context of flight evidence
# ────────────────────────────────────────────────────────────────────────────

# A UAV hosts the sensors that produce the telemetry a FlightEvidence attests.
skyrwa:UAV rdfs:subClassOf sosa:Platform .

# The telemetry bundle attested by a FlightEvidence corresponds to a
# sosa:ObservationCollection; SkyRwa does not re-model individual
# observations, it governs signed attestations over observation bundles.
skyrwa:FlightEvidence rdfs:seeAlso sosa:ObservationCollection ;
    rdfs:comment "A signed, digest-carrying attestation over a bundle of sensor observations (cf. sosa:ObservationCollection); governance applies to the attestation, not to individual observations."@en .

# ────────────────────────────────────────────────────────────────────────────
# Schema.org / Dublin Core Alignments — basic metadata
# ────────────────────────────────────────────────────────────────────────────

skyrwa:flightId rdfs:subPropertyOf dcterms:identifier .
skyrwa:startTime rdfs:subPropertyOf schema:startTime .
skyrwa:endTime rdfs:subPropertyOf schema:endTime .
skyrwa:estimatedValue rdfs:subPropertyOf schema:price .
