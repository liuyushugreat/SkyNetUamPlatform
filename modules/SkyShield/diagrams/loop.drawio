        <mxCell id="s_det" value="Detection&#10;budget 60 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="190" y="75" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s_track" value="Track+Confirm&#10;budget 80 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="75" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s_fuse" value="Fusion&#10;budget 25 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="75" width="140" height="60" as="geometry"/>
