        </mxCell>

        <mxCell id="abort" value="AbortController&#10;hard deadline  200 ms&#10;latency mean = 90 + 60load  ms&#10;slack-stealing tail  1.6x mean&#10;return_safe  interceptor RTB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=11;align=left;" vertex="1" parent="1">
