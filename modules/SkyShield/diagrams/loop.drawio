          <mxGeometry x="700" y="75" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s_launch" value="Launch&#10;budget 120 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="75" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s_int" value="Interceptor&#10;Reaction&#10;budget 250 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="75" width="140" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="sched" value="DeadlineScheduler  (RM + EDF + slack-stealing)&#10;end-to-end deadline  1500 ms    |    target p99  1450 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="190" y="180" width="990" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="guard" value="SafetyGuard  (per-tick)&#10; authorization&#10; friendly-clear  ~  geofence&#10; class_confidence  0.7&#10; lock_lost  abort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=11;align=left;" vertex="1" parent="1">
